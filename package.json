{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:release-gate": "tsx scripts/release-gate-selftest.ts",
    "test:station-packet": "tsx scripts/station-packet-selftest.ts",
    "test:pair-listen": "tsx scripts/pair-listen-selftest.ts",
    "test:exchange": "tsx scripts/exchange-selftest.ts",
    "test:voice-render": "tsx scripts/voice-render-selftest.ts",
    "test:voice-provider": "tsx scripts/voice-provider-selftest.ts",
    "test:broadcast-receipt": "tsx scripts/broadcast-receipt-selftest.ts",
    "test:listener-return": "tsx scripts/listener-return-selftest.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
